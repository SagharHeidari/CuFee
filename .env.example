# Copy to .env and adjust. .env is git-ignored - never commit secrets.

# Local default is SQLite (no setup). For PostgreSQL (e.g. docker compose up db):
# DATABASE_URL=postgresql+psycopg2://cx_user:cx_password@localhost:5432/cx_analytics

# Optional: enables the "Ask AI" tab to use Claude instead of the rule-based summary
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
